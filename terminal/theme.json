{
 "name": "Terminal",
 "author": "cubk",
 "base": "dark",
 "colors": {
  "accent": "#5FD7FF",
  "shell": "#000000",
  "sidebar": "#000000",
  "panel": "#080808",
  "surface": "#0E0E0E",
  "surfaceRaised": "#161616",
  "menu": "#0E0E0E",
  "textPrimary": "#E4E4E4",
  "textSecondary": "#BCBCBC",
  "textMuted": "#8A8A8A",
  "outline": "#4E4E4E",
  "outlineSoft": "#3A3A3A",
  "panelOutline": "#5F5F5F",
  "groupOutline": "#3A3A3A",
  "navHover": "#1C1C1C",
  "rowHover": "#1C1C1C",
  "onAccent": "#000000"
 },
 "contrast": {
  "guard": true,
  "min": 4.5
 },
 "style": {
  "radius": {
   "absolute": 0,
   "window": 0,
   "pills": "square"
  },
  "icons": false,
  "sounds": false,
  "animations": false
 },
 "layout": {
  "preset": "sidebar",
  "sidebar": {
   "width": 200
  }
 },
 "fonts": {
  "text": {
   "system": [
    "Cascadia Mono",
    "Consolas",
    "monospace"
   ]
  },
  "code": {
   "system": [
    "Cascadia Mono",
    "Consolas",
    "monospace"
   ]
  }
 },
 "paints": {
  "navActive": {
   "layers": [
    {
     "type": "solid",
     "color": "#5FD7FF33"
    },
    {
     "type": "solid",
     "color": "#000000",
     "inset": 1,
     "opacity": 0.0
    }
   ]
  }
 }
}